{
  "manifest_version": 3,
  "name": "Ghost Mode - Chrome Tàng Hình & Trong Suốt",
  "version": "1.0.0",
  "description": "Làm trong suốt trang web, mờ ảnh/video, ngụy trang tài liệu và phím tắt Boss Key giúp bạn lướt web mà người từ xa không thể chú ý.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Ghost Mode - Chế Độ Tàng Hình"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle_ghost_mode": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Bật/Tắt chế độ tàng hình"
    },
    "panic_boss_key": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Boss Key: Ẩn ngay lập tức / Màn hình ngụy trang"
    },
    "decrease_opacity": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Giảm độ rõ (Tăng độ trong suốt)"
    },
    "increase_opacity": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Tăng độ rõ (Giảm độ trong suốt)"
    },
    "toggle_media_blur": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Bật/Tắt làm mờ ảnh & video"
    },
    "toggle_blur": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Bật/Tắt nhanh làm mờ nhòe (Heavy Blur)"
    }
  }
}
